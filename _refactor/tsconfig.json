{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  // 测试用 `node --test` 跑（Node 自带 TS 类型擦除），需要 @types/node。
  // 本项目刻意不装它 —— 浏览器工程装一套 Node 类型只会让 window/DOM 变可选。
  // 所以测试文件不进 tsc，类型错误靠 node --test 报。
  "exclude": ["src/**/*.test.ts"]
}
