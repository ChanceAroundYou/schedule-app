# 部署产物（由 app/ 的 vite build 生成，不手改）
dist/

# TypeScript 增量编译缓存（tsc -b 产生）
*.tsbuildinfo

# 依赖。**不带结尾斜杠**：仓库里那个 node_modules 是软链（指向本机磁盘，
# 见 deploy/install-deps.sh），而带斜杠的模式只匹配真目录，会漏掉它。
# worktree 里 app/node_modules 也是符号链接，`node_modules/` 带斜杠的写法同样会漏。
node_modules

# 后端运行时数据：SQLite 库 + JWT 密钥 + 用户表。永远不进版本库。
server/data/

# 本地 agent 痕迹：不对外，也不该进版本库
.claude/
.mindfs/
.omc/
.workbuddy/
.vscode/
.idea/

# 系统杂物
.DS_Store
Thumbs.db
*.swp
*~

# 无头 Chrome 的临时 profile（tests/ 探针跑出来的）+ 部署产物备份
.tmp-*/
legacy-dist-backup/

# release 签名：keystore 密码表（keystore 本体在 ~/.android/，本就不在仓库里）
app/android/keystore.properties
*.jks
