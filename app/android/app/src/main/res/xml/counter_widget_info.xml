<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面计数器小组件的元信息 —— **方入口**（2×2 用，上下两块）。

  和 counter_widget_wide_info.xml（4×1 入口）是同一套代码的两个桌面条目：
  本文件对应 CounterWidgetProvider，宽入口对应 CounterWidgetWideProvider
  （零逻辑，全继承）。渲染按实测宽高比挑布局（isWide），入口只决定
  添加页里的预设形状。

  minWidth/minHeight 取 110×60：110 是「2 列」的下限，60 是「1 行」的下限 ——
  两个都放开，才能从 2×2 一路拖到 4×1。**minResize 不要调大**：
  一旦抬到 130 之类，4×1 那种扁形状就拖不出来了。

  updatePeriodMillis 给 0：这块数据全靠点击和 App 主动刷新，定时顶用不上，
  设成 30 分钟只会白耗电。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_counter_v"
    android:minWidth="110dp"
    android:minHeight="60dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_counter_v"
    android:targetCellWidth="2"
    android:targetCellHeight="2" />
