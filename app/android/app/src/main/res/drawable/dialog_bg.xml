<?xml version="1.0" encoding="utf-8"?>
<!--
  三个**弹框**的底板。

  为什么不直接复用 widget_bg：那是**小组件自己**的底板（20dp 圆角），
  而弹框要更方一点（用户 2026-10-14：编辑弹窗「圆角较大」）。两者分开，
  改弹框外形不会连小组件一起改。

  ⚠️ 光改这里还不够：Activity 的**窗口背景**（Theme.AppCompat.Dialog 默认的
  浅色小圆角矩形）会在这一圈圆角外面露出来，形成「四个亮白小圆角」。
  所以三个弹框都换成了 windowBackground=透明 的 AppTheme.WidgetDialog。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F1F8F3" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#D5E7DA" />
</shape>
