<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件底板。配色取自 app/public/icon.svg 那一组（绿 #27795A / 青 #3F7D8C），
  底色是它压亮后的浅绿 —— 跟参考图一致，也跟 App 的亮色主题同一套。
  **别在这里写死十六进制**：换主题要改三处，建议以后提到 colors.xml。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F1F8F3" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#D5E7DA" />
</shape>
