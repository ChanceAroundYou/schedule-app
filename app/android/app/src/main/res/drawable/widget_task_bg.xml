<?xml version="1.0" encoding="utf-8"?>
<!--
  任务块底：未完成的「进行中」态（浅绿底 + 深绿字）。

  2026-10-14：颜色统一 —— 未完成的任务与未完成的打卡**同一绿系**
  （见 widget_habit_bg_done.xml）；完成的任务与完成的打卡**同一浅灰**
  （见 widget_task_bg_done.xml）。

  2026-10-14（本轮）：用户嫌深绿 #27795A 太重太难看，深度大幅调浅 →
  浅绿 #D0E9D7 + 深绿字 #1B3A2A（见 ScheduleWidgetProvider 里的文字色）。
  「未完成 / 已完成」两类靠 绿 vs 灰 区分，不再靠深浅。

  左侧竖条已在 2026-10-14 去掉，几何参数保持一致：
  圆角 4dp，上下内缩 1.5dp 留出卡片间缝隙（内间距，不占布局高度，
  否则会和整点线错位）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#D0E9D7" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
