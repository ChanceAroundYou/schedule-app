<?xml version="1.0" encoding="utf-8"?>
<!--
  任务块底：浅绿 + 左侧一条主绿竖条。

  2026-10-13 三处调整（用户反馈）：
  1. **圆角 7dp → 4dp** —— 「卡片圆角太大，再方一点」。
  2. **上下各内缩 1dp**（`android:top/bottom`）。这是**内间距**：
     相邻两个任务的卡片之间自然留出一条缝，而**视图自身的布局高度不变** ——
     所以不会像 margin 那样把卡片顶开、和整点线错位。
  3. **左侧竖条上下多缩到 2dp**，避开卡片的圆角、显得是刻意留白；
     文字靠 `paddingLeft` 和它拉开距离（见 widget_task_block.xml）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#DFF0E5" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:width="2dp"
        android:top="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#27795A" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
