<?xml version="1.0" encoding="utf-8"?>
<!--
  任务块底：未完成的「进行中」态（主绿实心 + 白字）。

  2026-10-14：颜色统一 —— 未完成的任务与未完成的打卡**同一主绿**
  （#27795A 实心 + 白字）；完成的任务与完成的打卡**同一浅灰**
  （见 widget_task_bg_done.xml）。以前任务未完成是浅绿、打卡未完成是深绿，
  两种绿对不上，现在并成一种，一眼能区分「未完成 / 已完成」两类。

  左侧竖条已在 2026-10-14 去掉（见历史说明），几何参数保持一致：
  圆角 4dp，上下内缩 1.5dp 留出卡片间缝隙（内间距，不占布局高度，
  否则会和整点线错位）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#27795A" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
