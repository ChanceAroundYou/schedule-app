<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡格：已打（完成态）。浅灰底 + 灰字，与「已完成任务」（widget_task_bg_done）
  同一套浅灰，做到「完成的打卡」和「完成的任务」颜色统一。

  圆角 5dp（与未打态 / 其它打卡格一致）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E9EDEA" />
    <corners android:radius="5dp" />
    <stroke android:width="1dp" android:color="#D2D9D5" />
</shape>
