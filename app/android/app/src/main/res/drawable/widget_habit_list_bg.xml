<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡组件 ListView（hab_list）的背景。

  2026-11-05 新建：用户报「打卡内容区的淡绿色方形左下/右下角超出了组件圆角边界」。
  根因：容器 widget_bg.xml 圆角 20dp，但 ListView 背景是直角色值 #E7F3EA，
  直角方形的角露在容器圆弧外。

  修法：把 ListView 背景从直角色值改成圆角 shape。RemoteViews 不支持运行时
  clipToOutline 裁剪，只能让内容区自己画圆角。圆角 12dp（比容器 20dp 小，
  因为 ListView 在容器 padding 6dp 内，视觉上两层圆角嵌套自然）。

  ListView 的子项（chip）有自己的 5dp 圆角背景，且 chip 有 margin 1dp +
  ListView padding 2dp，不会溢出这个 12dp 圆角。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E7F3EA" />
    <corners android:radius="12dp" />
</shape>
