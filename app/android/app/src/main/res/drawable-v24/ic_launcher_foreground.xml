<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器图标前景层：app/public/icon.svg 里的白色日历（描边风格）。
  原图是 32×32 画布 + translate(4,4) 后的 24×24 日历，描边宽 2。
  这里换算到 108dp 自适应画布：日历目标宽约 62dp（安全区是中心 72dp，
  留出 57% 而不是塞满 66%，是因为部分启动器会给前景加视差缩放，
  塞太满会被裁）。scale = 62/24 ≈ 2.583，平移 (23,23) 居中。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <group
        android:scaleX="2.583"
        android:scaleY="2.583"
        android:translateX="23"
        android:translateY="23">
        <!-- 挂环 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M8,2v3"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2.6" />
        <path
            android:fillColor="#00000000"
            android:pathData="M16,2v3"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2.6" />
        <!-- 主体：rx=2 的 18×18 圆角矩形（VectorDrawable 无 rect 元素，用弧线写） -->
        <path
            android:fillColor="#00000000"
            android:pathData="M5,3h16a2,2 0 0 1 2,2v16a2,2 0 0 1 -2,2h-16a2,2 0 0 1 -2,-2v-16a2,2 0 0 1 2,-2z"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2.6" />
        <!-- 表头分隔线 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M3,9h18"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2.6" />
        <!-- 对勾 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M9,15l2,2l4,-4"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2.6" />
    </group>
</vector>
