<?xml version="1.0" encoding="utf-8"?>
<!--
  日期条上的一格。

  **选中高亮只包日期数字，不包星期**（用户 2026-10-14 第八轮）：
  星期几（一二三四五六日）是固定的，翻上/下周都一样，用颜色圈它没意义；
  圈只该套住会变的「几号」。

  结构：外层 FrameLayout 只负责等分占位；里面竖直排「星期（无底）」+
  「日期（正圆底 + 数字）」。圆是一个**固定 22dp × 22dp 的 FrameLayout**，
  宽高相等 → 永远是正圆。

  2026-10-14：星期 8 → 9sp、日期 11 → 12sp，行距略放大（用户要求）；
  2026-10-25 整体小 1sp：星期 8sp、日期 11sp，圆 22 → 20dp。
  但仍明显小于标题。

  2026-11-03：给圆的父 FrameLayout 加 id（chip_frame），代码按 k 缩放这一个
  框即可 —— 圆和数字都改成 match_parent 跟着框走（宽=高 → 永远是正圆），
  免得三个视图各缩各的、圆和数字错位。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_root"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 星期：始终无底，选中时只换字色（不再变白）。字号随 k（代码里 setTextViewTextSize） -->
        <TextView
            android:id="@+id/chip_wd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一"
            android:textColor="#6B8574"
            android:textSize="8sp" />

        <!-- 日期：圆形高亮只作用于这一格（圆底在 chip_circle，数字在 chip_date） -->
        <FrameLayout
            android:id="@+id/chip_frame"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/chip_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="" />

            <TextView
                android:id="@+id/chip_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="12"
                android:textColor="#1B3A2A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 「这天还有没做完的」小圆点（2026-11-06 用户：三端统一，纯圆点不带条数）。
             **每天都占着这一格**、没得点时只把底色清成 0（和上面 chip_circle
             选中/未选中同一套做法）—— 这样日期条的高度恒定；只在该有的那天
             冒出来会把整条撑高几 dp，同一行里别的日期看着就是没对齐
             （App 端 `.wh-dot` 同一条教训）。TextView + 圆底是这个组件里
             已验证可用的画法（chip_circle 就是这么画的）。 -->
        <TextView
            android:id="@+id/chip_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:text="" />
    </LinearLayout>
</FrameLayout>
