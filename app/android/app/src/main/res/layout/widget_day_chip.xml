<?xml version="1.0" encoding="utf-8"?>
<!--
  日期条上的一格。

  2026-10-13 改：**选中态要正圆**。
  以前把 oval 背景直接铺在「整个格子」上，而格子是 `0dp + weight` 均分出来的
  矩形（宽 > 高），oval 套矩形必然拉成椭圆。现在改成：
    外层 FrameLayout 只负责「等分占位」，
    里面一个**固定 26dp × 26dp 的圆**居中 —— 宽高相等，永远是正圆。
  圆里放「星期 + 日期」两行（用户要的：圆套整个格子含星期），字号相应缩到
  8sp / 11sp 才塞得进 26dp。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_root"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/chip_circle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chip_wd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一"
            android:textColor="#6B8574"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/chip_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textColor="#1B3A2A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
