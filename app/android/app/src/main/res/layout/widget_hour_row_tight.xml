<?xml version="1.0" encoding="utf-8"?>
<!--
  时间轴的一行 · 紧凑档。

  小时数多的时候（比如时间轴设成 6:00–23:00，18 行）用这一档，
  否则一屏塞不进。刻度缩到 9sp、行压到 15dp，任务块仍会把有任务的
  那几行撑到自己的高度 —— 所以紧凑的是**空白**，不是任务。

  说明见 widget_hour_row.xml。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hour_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="15dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/hour_label"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="07"
        android:textColor="#9DB2A5"
        android:textSize="8sp" />

    <LinearLayout
        android:id="@+id/hour_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
