<?xml version="1.0" encoding="utf-8"?>
<!--
  时间轴上的一个任务卡。

  **竖向 padding 全部去掉**（用户 2026-10-13 明确）：卡片高度由代码按
  「任务时长 × 每分钟 dp」钉死，多一分 padding 都会把所在时段撑高、
  和整点线对不齐。横向只留 4dp，纯粹为了文字不贴边。
  配色取自 App 标识那组绿。

  高度/字号都由代码 setViewLayoutHeight / setTextViewTextSize 现算。
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_block"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="1dp"
    android:layout_marginRight="2dp"
    android:background="@drawable/widget_task_bg"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:paddingLeft="4dp"
    android:paddingRight="3dp"
    android:textColor="#1B3A2A"
    android:textSize="10sp" />
