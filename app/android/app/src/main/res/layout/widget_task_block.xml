<?xml version="1.0" encoding="utf-8"?>
<!--
  时间轴上的一个任务块。配色取自 App 标识那组绿。

  **高度要贴住内容**：padding 3dp、maxLines 1。上一版是 5dp + 2 行，
  块高撑到 30dp 往上，而所在的行有 minHeight —— 两者对不齐，行与行之间
  就露出一条白缝。现在块高 ≈ 行 minHeight，空行和有任务的行连成一片。

  标题只留一行、超出省略：点一下就能进编辑弹框看全名，桌面上优先保证
  「一屏看完所有小时」。
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_block"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="1dp"
    android:layout_marginRight="2dp"
    android:layout_marginBottom="1dp"
    android:background="@drawable/widget_task_bg"
    android:ellipsize="end"
    android:maxLines="1"
    android:paddingLeft="8dp"
    android:paddingTop="3dp"
    android:paddingRight="6dp"
    android:paddingBottom="3dp"
    android:textColor="#1B3A2A"
    android:textSize="11sp" />
