<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡小组件布局（2026-11-04 拆分；2026-11-04 第二轮：去筛选 + 三点菜单 + ListView 滚动）。

  顶栏：日历徽标 + 月份 + 三点菜单（底板透明度 / 字体大小）。
  chip 区改成 ListView（RemoteViewsService 驱动），装不下时原生滚动。
  没有日期条、没有漏斗、没有刷新按钮 —— 越简单越好（用户原话）。

  RemoteViews 老规矩：ScrollView 不能用（launcher inflate 会抛），滚动只能靠
  ListView + setRemoteAdapter。容器/子视图白名单照旧。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="2dp">

    <!-- ============ 顶栏 ============ -->
    <FrameLayout
        android:id="@+id/hab_head"
        android:layout_width="match_parent"
        android:layout_height="30dp">

        <!-- 左上角：与日程组件同一枚黑白日历徽标，中间写今天几号 -->
        <FrameLayout
            android:id="@+id/hab_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="left|center_vertical"
            android:background="@drawable/ic_calendar_badge">

            <TextView
                android:id="@+id/hab_logo_day"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="4"
                android:textColor="#333333"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/hab_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="十一月"
            android:textColor="#1B3A2A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 右上角三点菜单（和日程组件同一枚 ic_more） -->
        <ImageView
            android:id="@+id/hab_settings_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="right|center_vertical"
            android:contentDescription="设置"
            android:padding="4dp"
            android:src="@drawable/ic_more" />
    </FrameLayout>

    <!-- ============ chip 区：ListView（装不下原生滚动） ============
         RemoteViews 的 ListView 要配 setRemoteAdapter + RemoteViewsService。
         divider 去掉（chip 自带间距）；background 由 Provider 按 alpha 设。 -->
    <ListView
        android:id="@+id/hab_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:background="#E7F3EA"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:padding="2dp"
        android:scrollbars="none" />

    <!-- 空态：没有打卡项时显示（Provider 按 VISIBLE/GONE 切） -->
    <TextView
        android:id="@+id/hab_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="还没有打卡项，打开 App 加一个"
        android:textColor="#8AA294"
        android:textSize="8sp"
        android:visibility="gone" />
</LinearLayout>
