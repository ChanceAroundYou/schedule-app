<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡小组件布局。

  2026-11-04 第三轮（用户）：header 大幅度压缩、两侧边缘缩小、多让位置给正文；
  **不再显示月份，只显示今天日期**；字体和三点缩小；左侧图标换成打卡勾。
    · 顶栏 30dp → 20dp
    · 左右 padding 8dp → 6dp（正文因此左右各多 2dp）
    · 徽标 26dp → 18dp、号数 10sp → 9sp
    · 月份整行删掉，号数直接跟在徽标左边（行内靠左，不再居中）
    · 三点 26dp → 18dp、padding 4dp → 3dp
    · 左侧图标 ic_calendar_badge → ic_habit_check（打勾徽标）

  chip 区是 ListView（RemoteViewsService 驱动），装不下时原生滚动。
  RemoteViews 老规矩：ScrollView 不能用（launcher inflate 会抛）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="5dp"
    android:paddingRight="6dp"
    android:paddingBottom="2dp">

    <!-- ============ 顶栏（20dp，紧凑） ============ -->
    <FrameLayout
        android:id="@+id/hab_head"
        android:layout_width="match_parent"
        android:layout_height="20dp">

        <!-- 左侧：打卡勾徽标 + 今天几号（横排、靠左）。
             原来这里是「日历徽标 + 居中月份」，用户觉得太占地方 → 月份删掉，
             号数直接挨着图标。 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="left|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hab_logo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="打卡"
                android:src="@drawable/ic_habit_check" />

            <TextView
                android:id="@+id/hab_logo_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="11月4日"
                android:textColor="#1B3A2A"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右上角三点菜单（缩小到 18dp） -->
        <ImageView
            android:id="@+id/hab_settings_btn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="right|center_vertical"
            android:contentDescription="设置"
            android:padding="1dp"
            android:src="@drawable/ic_more" />
    </FrameLayout>

    <!-- ============ chip 区：ListView（装不下原生滚动） ============
         RemoteViews 的 ListView 要配 setRemoteAdapter + RemoteViewsService。
         divider 去掉（chip 自带间距）；background 由 Provider 按 alpha 设。 -->
    <ListView
        android:id="@+id/hab_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_habit_list_bg"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:padding="2dp"
        android:scrollbars="none" />

    <!-- 空态：没有打卡项时显示（Provider 按 VISIBLE/GONE 切） -->
    <TextView
        android:id="@+id/hab_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="还没有打卡项，打开 App 加一个"
        android:textColor="#8AA294"
        android:textSize="8sp"
        android:visibility="gone" />
</LinearLayout>