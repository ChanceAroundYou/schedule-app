<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡小组件设置弹框（2026-11-04 第二轮）。
  只有「底板透明度」+「字体大小」两项 —— 和日程组件那套的子集，
  视觉语言完全一致（颜色 / 字号 / 间距 / SeekBar 样式同一份）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="打卡组件设置"
        android:textColor="#1B3A2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ============ 底板透明度 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="底板透明度"
            android:textColor="#6B8574"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/s_alpha_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#27795A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/s_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="60"
        android:progress="60"
        android:progressTint="#27795A"
        android:thumbTint="#27795A" />

    <!-- ============ 字体大小 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="字体大小"
            android:textColor="#6B8574"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/s_font_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标准"
            android:textColor="#27795A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/s_font"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="3"
        android:progress="1"
        android:progressTint="#27795A"
        android:thumbTint="#27795A" />

    <!-- ============ 数据（2026-11-06 用户：打卡组件也要有刷新，跟日程组件统一） ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="数据"
        android:textColor="#6B8574"
        android:textSize="11sp" />

    <Button
        android:id="@+id/s_refresh"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dialog_field"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="立即刷新（拉服务器最新）"
        android:textColor="#27795A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/s_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8AA294"
        android:textSize="10sp" />
</LinearLayout>
