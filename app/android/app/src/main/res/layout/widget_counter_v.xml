<?xml version="1.0" encoding="utf-8"?>
<!--
  计数器小组件 —— **方的**（2×2 用）。上下两块，各占一半。

  ## 为什么是两套 layout 而不是一套自适应
  RemoteViews 里的控件全是固定 dp，没有 flex-percent 那套（layout_weight
  只能分配剩余空间，改不了按钮的绝对尺寸）。方形和扁形名字行的宽度不一样，
  与其在两套之间做一堆运行时计算，不如各写一份、由 provider 按宽高比挑。
  **两份的 id 与控件类型必须完全一致** —— 渲染代码只有一套（见 widget_counter_h.xml）。

  ## 为什么全是 ImageView
  名字（Baloo2 超粗 + 同底色描边）、数字、加减号**全部**由
  CounterWidgetProvider 画成位图。原因有三：
    1. RemoteViews 的 TextView 不认 @font 之外的自定义字体，且没有 text-stroke；
    2. `−`(U+2212) 在 Baloo2 里没有字形，会掉到系统字体，和 `+` 不是一套；
    3. 文字与数字要做到「一个字号常量、两行等高」，只有自己画才可控。

  ⚠️ **scaleType 必须是 center，不能是 fitCenter。**
  位图按视图的像素尺寸 1:1 生成，fitCenter 在尺寸差几个像素时会二次缩放，
  字号就不再是设定的值。center 是「不缩放、居中」，超宽的部分由 Canvas
  边界裁掉 —— 这就是方案 A（宁可裁，不缩字）。

  ⚠️ 下面这些 dp 必须与 CounterWidgetProvider 的常量一一对应，改这里就改那里：
    整卡 padding 3dp      = PAD_DP
    块间 margin 3dp       = GAP_DP
    名字行高 28dp         = ROW_DP
    加减按钮 40dp         = BTN_DP
    数字行左右 padding 1dp = SIDE_DP
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ctr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ctr_card_bg"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- ── naonao ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="3dp"
        android:background="@drawable/ctr_zone_pink"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ctr_a_name"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:scaleType="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="1dp"
            android:paddingRight="1dp">

            <ImageView
                android:id="@+id/ctr_a_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ctr_btn_minus_pink"
                android:scaleType="center" />

            <ImageView
                android:id="@+id/ctr_a_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center" />

            <ImageView
                android:id="@+id/ctr_a_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ctr_btn_plus_pink"
                android:scaleType="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Kutai ────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/ctr_zone_green"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ctr_b_name"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:scaleType="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="1dp"
            android:paddingRight="1dp">

            <ImageView
                android:id="@+id/ctr_b_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ctr_btn_minus_green"
                android:scaleType="center" />

            <ImageView
                android:id="@+id/ctr_b_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center" />

            <ImageView
                android:id="@+id/ctr_b_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ctr_btn_plus_green"
                android:scaleType="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
