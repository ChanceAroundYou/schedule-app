<?xml version="1.0" encoding="utf-8"?>
<!-- 新建任务弹框。

     2026-10-13：单一的「时间」按钮改成**开始 / 结束两个表盘**，和编辑弹框一致。
     2026-10-14（第七轮）：跟编辑弹框**统一**——
       · 标题居中、14sp（原来左对齐 15sp）
       · 输入框加 dialog_field 浅绿底 + 36dp 高（原来裸 EditText，没框）
       · 起止时间按钮由 widget_chip_bg 换成 dialog_field、高 34dp 写死
       · 底排 取消 / 保存 高 36dp、去掉多余内边距（避免文字被裁）
       · 宽 272dp、padding 14/12，与 dialog_task 完全一致 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="新建任务"
        android:textColor="#1B3A2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/c_title"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:hint="做什么"
        android:inputType="text"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textColor="#1B3A2A"
        android:textColorHint="#9BB3A5"
        android:textSize="13sp" />

    <!-- 起止时间：两个按钮，点了各弹一个系统表盘（TimePickerDialog）。
         手打「09:30」要切键盘、要记格式，桌面上做快速记一笔时最烦这一步。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_start"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:gravity="center"
            android:text="至"
            android:textColor="#8AA294"
            android:textSize="11sp" />

        <Button
            android:id="@+id/c_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/c_durhint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#8AA294"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#E4EFE8"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="取消"
            android:textColor="#6B8574"
            android:textSize="13sp" />

        <Button
            android:id="@+id/c_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="保存"
            android:textColor="#27795A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
