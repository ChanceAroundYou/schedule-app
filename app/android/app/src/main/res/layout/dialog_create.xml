<?xml version="1.0" encoding="utf-8"?>
<!-- 新建任务弹框。

     2026-10-13：单一的「时间」按钮改成**开始 / 结束两个表盘**，和编辑弹框一致
     （用户要求任务能设起止时间）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="新建任务"
        android:textColor="#1B3A2A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/c_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="做什么"
        android:inputType="text"
        android:textColor="#1B3A2A"
        android:textColorHint="#8AA294"
        android:textSize="13sp" />

    <!-- 起止时间：两个按钮，点了各弹一个系统表盘（TimePickerDialog）。
         手打「09:30」要切键盘、要记格式，桌面上做快速记一笔时最烦这一步。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_start"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="至"
            android:textColor="#6B8574"
            android:textSize="12sp" />

        <Button
            android:id="@+id/c_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/c_durhint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#8AA294"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="#6B8574"
            android:textSize="13sp" />

        <Button
            android:id="@+id/c_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保存"
            android:textColor="#27795A"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
