<?xml version="1.0" encoding="utf-8"?>
<!-- 新建任务弹框。

     2026-10-13：单一的「时间」按钮改成**开始 / 结束两个表盘**，和编辑弹框一致。
     2026-10-14（第九轮）：补两项 ——
       · **重复**（c_repeat）：点开单选 不重复/每天/每周/每月/每年，
         写入标准 RepeatRule（App 里能看到、可再细化）。
       · **提醒**（c_remind）：点开弹时间选择器选 HH:mm，写入 reminder 字段；
         到点由小组件的通知负责（见 ReminderScheduler / ReminderReceiver）。
       重复与提醒并排放一行，省纵向空间。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="新建任务"
        android:textColor="#1B3A2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/c_title"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:hint="做什么"
        android:inputType="text"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textColor="#1B3A2A"
        android:textColorHint="#9BB3A5"
        android:textSize="13sp" />

    <!-- 日期：整行按钮，点了弹日历选择器 -->
    <Button
        android:id="@+id/c_date"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="2026-10-14 周三"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- 重复 + 提醒：并排一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_repeat"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不重复"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />

        <Button
            android:id="@+id/c_remind"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不提醒"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 起止时间：两个按钮，点了各弹一个系统表盘（TimePickerDialog） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_start"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:gravity="center"
            android:text="至"
            android:textColor="#8AA294"
            android:textSize="11sp" />

        <Button
            android:id="@+id/c_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/c_durhint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#8AA294"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#E4EFE8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="取消"
            android:textColor="#6B8574"
            android:textSize="13sp" />

        <Button
            android:id="@+id/c_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="保存"
            android:textColor="#27795A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
