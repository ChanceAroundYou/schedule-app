<?xml version="1.0" encoding="utf-8"?>
<!-- 新建任务弹框。

     2026-10-14（第十轮）按用户要求重排：
       · 时间 / 重复 / 提醒 **各占一行**（不再并排）。
       · 时间**只设开始时间** —— 去掉「至结束」。要设一整段时间就点开该任务、
         在**编辑弹窗**里补结束时间（那边的时间段是完整的）。
       · 重复支持**预设 + 结束条件**（不结束 / 按次数 / 按日期）。
     -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="252dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="新建任务"
        android:textColor="#1B3A2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 行1：任务名 -->
    <EditText
        android:id="@+id/c_title"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:hint="做什么"
        android:inputType="text"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textColor="#1B3A2A"
        android:textColorHint="#9BB3A5"
        android:textSize="13sp" />

    <!-- 行2：日期 -->
    <Button
        android:id="@+id/c_date"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="2026-10-14 周三"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- 行3：开始时间（只有开始；时间段去编辑弹窗设） -->
    <Button
        android:id="@+id/c_start"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="开始时间：不设置"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- 行4：重复 -->
    <Button
        android:id="@+id/c_repeat"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="重复：不重复"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- 行5：提醒 -->
    <Button
        android:id="@+id/c_remind"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="提醒：不提醒"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/c_durhint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#8AA294"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#E4EFE8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/c_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="取消"
            android:textColor="#6B8574"
            android:textSize="13sp" />

        <Button
            android:id="@+id/c_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="保存"
            android:textColor="#27795A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
