<?xml version="1.0" encoding="utf-8"?>
<!--
  日程小组件布局。

  ⚠️ RemoteViews 的限制（改之前先看）：
  1. 容器只能是 FrameLayout / LinearLayout / RelativeLayout / GridLayout。
     用 ScrollView 之类**不是「滚不动」，而是 launcher inflate 时直接抛异常**，
     整个组件变成一块「载入窗口小部件时出现问题」的空板，应用侧零日志。
  2. 子视图白名单里**没有裸 `<View>`**，占位条 / 分隔线一律用空 TextView。
  3. 不能测量宽高 → 「自适应」只能自己算。
  4. 接不到手势。
  5. `setViewLayoutHeight` 是 API 31（Android 12）起才有的 —— 时间轴靠它
     把每个元素的高度钉死。

  ≡≡ 结构（2026-10-13 定）≡≡

  head 行 / 日期条 / 打卡区 → 尺寸固定，不随组件缩放。

  然后是一个**十字面板**（未定时与已定时是同一条面板的四格）：

       ┌──────┼────────────────────────────┐
       │ 空白 │ [未1][未2][未3][未4][未5]+N │ ← 顶行（常驻）
       ├──────┼────────────────────────────┤ ← 横分割线
       │  08  │────── 小时细线 ────────────│
       │  09  │  ██████                    │ ← 右下：主体
       └──────┴────────────────────────────┘
        刻度列      竖分割线 + 主体

  · 左上空白角 = 「未定时」的标记，不写字，**永远常驻**
  · 细线只画在右下主体里 —— 这是**结构保证**的（它是 tl_frame 的子视图）
  · 竖分割线与横分割线是「十字线」；右下的小时线颜色更淡，两者一眼可分
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ============ head：所有可点控件统一 22dp 方框、垂直居中 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="回到今天"
            android:padding="2dp"
            android:src="@drawable/ic_widget_logo" />

        <TextView
            android:id="@+id/btn_prev_month"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#4A6B58"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_month"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="十月"
            android:textColor="#1B3A2A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_next_month"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#4A6B58"
            android:textSize="16sp" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#DDE5DD"
            android:text="" />

        <ImageView
            android:id="@+id/btn_add"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="新建任务"
            android:padding="5dp"
            android:src="@drawable/ic_plus" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="小组件设置"
            android:padding="5dp"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- ============ 日期条（一周七天，选哪天就只看哪天）============ -->
    <LinearLayout
        android:id="@+id/date_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal" />

    <!-- ============ 打卡区 ============
         上下对称：容器 padding 2dp + 每格上下各 1dp margin = 上 3 / 下 3。
         （以前格子只有 marginTop、没有 marginBottom，导致上 5 下 3。） -->
    <LinearLayout
        android:id="@+id/habit_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="#E7F3EA"
        android:orientation="vertical"
        android:padding="2dp"
        android:visibility="gone" />

    <!-- ============ 十字面板 ============ -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 顶行：左空白角（= 未定时的标记）+ 右未定时横条。常驻，高度固定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:text="" />

            <LinearLayout
                android:id="@+id/untimed_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 横分割线（十字线之一） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#C6DCCF"
            android:text="" />

        <!-- 底行：刻度列 + 竖分割线 + 主体 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tl_scale"
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <!-- 竖分割线（十字线之一） -->
            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#C6DCCF"
                android:text="" />

            <FrameLayout
                android:id="@+id/tl_frame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/tl_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />

                <!-- 「现在」红线：夹在网格和任务之间，不挡卡片点击 -->
                <LinearLayout
                    android:id="@+id/tl_now"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/tl_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingLeft="2dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部状态 -->
    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text=""
        android:textColor="#6B8574"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
