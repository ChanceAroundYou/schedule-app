<?xml version="1.0" encoding="utf-8"?>
<!--
  日程小组件布局

  ⚠️ RemoteViews 的限制：**不能用** ConstraintLayout / 自定义 View / 任何
  需要 inflate 后才知道宽高的东西。能用的只有 LinearLayout / FrameLayout /
  RelativeLayout 和那几个官方控件。所以时间轴用「每小时一行」的 LinearLayout
  堆出来，任务块塞进它开始的那一行 —— 不用绝对定位。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- ============ 月份行 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 应用标识，复用 app/public/icon.svg（见 ic_widget_logo.xml 的说明） -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginRight="2dp"
            android:contentDescription="日程清单"
            android:src="@drawable/ic_widget_logo" />

        <ImageView
            android:id="@+id/btn_prev_month"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="上一个月" />

        <TextView
            android:id="@+id/tv_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="十月"
            android:textColor="#1B3A2A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_next_month"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="5dp"
            android:contentDescription="下一周"
            android:src="@drawable/ic_chevron_right" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:background="#DDE5DD"
            android:text="" />

        <ImageView
            android:id="@+id/btn_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:contentDescription="新建任务"
            android:src="@drawable/ic_plus" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="7dp"
            android:contentDescription="小组件设置"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- ============ 日期条（一周七天，选哪天就只看哪天）============ -->
    <LinearLayout
        android:id="@+id/date_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <!-- ============ 打卡区 ============
         纵向容器，**每行由代码按固定个数分包**（不是全塞一行）。
         以前塞一行，勾选后 chip 变宽（多了个 ✓）就把后面的顶出可视区 ——
         而且看不出来是被顶掉了，像是「打卡项消失了」。 -->
    <LinearLayout
        android:id="@+id/habit_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#E7F3EA"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:background="#DCE9DF"
        android:text="" />

    <!-- ============ 时间轴（每小时一行，动态加）============
         ⚠️ **不能包 ScrollView**：RemoteViews 只支持 FrameLayout / LinearLayout /
         RelativeLayout / GridLayout 这四种。用 ScrollView 的后果不是「滚不动」，
         而是 launcher inflate 时直接抛 InflateException，整个组件显示
         「载入窗口小部件时出现问题」—— 桌面上一片空白，无从下手。

         所以「看不到更晚的小时」不能靠滑动解决（RemoteViews 也接不到手势），
         改成右侧一列**翻页箭头**：一屏放不下时按页平移，看得到 6:00–23:00
         全部小时。翻页状态存在 WidgetPrefs，刷新后不回到顶部。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hour_rows"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- 翻页列。只有「一屏放不下」时才 VISIBLE，放得下就整个 GONE。

             用最普通的 TextView 打 ▲/▼ 字符，**不做新图标**：「可点 / 已到头」
             这两种状态靠 setTextColor 换色就够了（TextField 的 setTextColor 在
             RemoteViews 白名单里）。做一套图标 + 一套淡色图标要 4 个文件，
             而这里只需要改个颜色。 -->
        <LinearLayout
            android:id="@+id/scroll_col"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_scroll_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="▲"
                android:textColor="#27795A"
                android:textSize="10sp" />

            <!-- 撑开中间，把两个箭头推到上下两端 -->
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="" />

            <TextView
                android:id="@+id/btn_scroll_down"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="▼"
                android:textColor="#27795A"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部：更新时间 + 空状态 -->
    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text=""
        android:textColor="#6B8574"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
