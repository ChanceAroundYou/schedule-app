<?xml version="1.0" encoding="utf-8"?>
<!--
  日程小组件布局。

  ⚠️ RemoteViews 的限制：
  1. 不能用 ConstraintLayout / 自定义 View / 任何需要 inflate 后才知道宽高的东西。
     容器只能是 FrameLayout / LinearLayout / RelativeLayout / GridLayout。
  2. 用了不支持的容器（比如 ScrollView）**不是「滚不动」，而是 launcher
     inflate 时直接抛异常**，整个组件变成一块「载入窗口小部件时出现问题」
     的空板，应用侧一条日志都没有。
  3. 也**接不到手势**，所以「滑动看更晚的时间」做不了。

  ⇒ 于是这个组件的设计目标是：**一屏装下全部小时**，不做滚动也不做翻页。
    做法是把每一行压到刚好贴住内容（见 widget_hour_row.xml），
    再按总行数挑刻度字号。空行只占很薄的一条，有任务的行才撑开。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="9dp">

    <!-- ============ 月份行 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 应用标识，复用 app/public/icon.svg（见 ic_widget_logo.xml 的说明） -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="回到今天"
            android:src="@drawable/ic_widget_logo" />

        <ImageView
            android:id="@+id/btn_prev_month"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="上一周" />

        <TextView
            android:id="@+id/tv_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="十月"
            android:textColor="#1B3A2A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_next_month"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="5dp"
            android:contentDescription="下一周"
            android:src="@drawable/ic_chevron_right" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="#DDE5DD"
            android:text="" />

        <ImageView
            android:id="@+id/btn_add"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:contentDescription="新建任务"
            android:src="@drawable/ic_plus" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="6dp"
            android:contentDescription="小组件设置"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- ============ 日期条（一周七天，选哪天就只看哪天）============ -->
    <LinearLayout
        android:id="@+id/date_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <!-- ============ 打卡区 ============
         纵向容器，**每行由代码按固定个数分包**（不是全塞一行）。
         以前塞一行，勾选后 chip 变宽就把后面的顶出可视区 ——
         而且看不出来是被顶掉了，像是「打卡项消失了」。
         现在每行 4 个：常见习惯数量（6-9 个）刚好两行多，不至于把
         时间轴挤没。 -->
    <LinearLayout
        android:id="@+id/habit_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#E7F3EA"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="2dp"
        android:background="#DCE9DF"
        android:text="" />

    <!-- ============ 时间轴 ============
         **不滚、不翻页，一屏装完。** 行高由 widget_hour_row*.xml 的
         minHeight 决定，挑哪一档看总行数（行数多→刻度字号小、行更薄）。
         空行不塞子视图，自然就只是薄薄一条。 -->
    <LinearLayout
        android:id="@+id/hour_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!-- 底部状态 -->
    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text=""
        android:textColor="#6B8574"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
