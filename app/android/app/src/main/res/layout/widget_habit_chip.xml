<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡区的一格。

  **宽度用 weight 等分**（不是 wrap_content）—— wrap_content 时勾选后底色一变
  或系统字号一大，格子就变宽把后面的顶出去，看着像「打卡项不见了」。

  上下都留 1dp margin（以前只有 marginTop，导致整块上重下轻）。

  2026-10-13：字号 10sp → **9sp**（与小时刻度 / 任务卡 / 未定时卡统一），
  内边距 3dp → 2dp，圆角半径收到 9dp —— 用户要求更紧凑。
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_chip"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    android:layout_weight="1"
    android:background="@drawable/widget_habit_bg"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="1"
    android:paddingLeft="2dp"
    android:paddingTop="2dp"
    android:paddingRight="2dp"
    android:paddingBottom="2dp"
    android:textColor="#1B3A2A"
    android:textSize="9sp" />
