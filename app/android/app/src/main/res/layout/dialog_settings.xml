<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件设置弹框：时间轴范围 / 底板透明度 / 立即刷新。

  2026-10-13：整体缩小、字号调小（用户要求）；**去掉「恢复默认」「完成」两个
  按钮** —— 关闭改靠点弹框外部 / 返回键（见 WidgetSettingsActivity 里的
  setFinishOnTouchOutside）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="252dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="小组件设置"
        android:textColor="#1B3A2A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- ============ 时间轴范围 ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="时间轴范围"
        android:textColor="#6B8574"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/s_start"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_habit_bg"
            android:text="08:00"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:text="至"
            android:textColor="#6B8574"
            android:textSize="11sp" />

        <Button
            android:id="@+id/s_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_habit_bg"
            android:text="20:00"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/s_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8AA294"
        android:textSize="10sp" />

    <!-- ============ 底板透明度 ============
         拖到最右 = 完全不透明，最左 = 最透。
         ⚠️ 底下其实是**五档预置的 drawable**，只是把它包装成滑杆了：
         RemoteViews 调不到 View.setAlpha（没标 @RemotableViewMethod），
         透明度只能预先做成几档资源来切。滑杆松手时会吸附到最近的档位。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="底板透明度"
            android:textColor="#6B8574"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/s_alpha_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="不透明"
            android:textColor="#27795A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/s_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:max="4"
        android:progress="0"
        android:progressTint="#27795A"
        android:thumbTint="#27795A" />

    <!-- ============ 数据 ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="数据"
        android:textColor="#6B8574"
        android:textSize="11sp" />

    <Button
        android:id="@+id/s_refresh"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_habit_bg"
        android:text="立即刷新（拉服务器最新）"
        android:textColor="#27795A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/s_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#8AA294"
        android:textSize="10sp" />
</LinearLayout>
