<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件设置弹框：时间轴范围 / 底板透明度 / 立即刷新。

  2026-10-13：整体缩小、字号调小（用户要求）；**去掉「恢复默认」「完成」两个
  按钮** —— 关闭改靠点弹框外部 / 返回键（见 WidgetSettingsActivity 里的
  setFinishOnTouchOutside）。

  2026-10-14（第七轮）：跟编辑 / 新建弹框**统一**——
  · 标题居中、14sp（原来左对齐 13sp）
  · 时间轴 / 刷新按钮由 widget_habit_bg（**灰绿**，那是「已完成」语义色）
    换成 dialog_field（浅绿白）+ 高度写死 34dp
  · 宽 272dp、padding 14/12，三个弹框完全一致
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="小组件设置"
        android:textColor="#1B3A2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ============ 时间轴范围 ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="时间轴范围"
        android:textColor="#6B8574"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/s_start"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="08:00"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:gravity="center"
            android:text="至"
            android:textColor="#8AA294"
            android:textSize="11sp" />

        <Button
            android:id="@+id/s_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="20:00"
            android:textColor="#1B3A2A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/s_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8AA294"
        android:textSize="10sp" />

    <!-- ============ 底板透明度 ============
         拖到最右 = 完全不透明，最左 = 最透。连续可调（40%–100%）。
         ⚠️ 实现上是预烤了 31 张 drawable（每 2% 一张），按最近偶数档动态切，
         所以视觉上是平滑过渡，不是几档跳变。RemoteViews 不支持运行时 setAlpha。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="底板透明度"
            android:textColor="#6B8574"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/s_alpha_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#27795A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/s_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:max="60"
        android:progress="60"
        android:progressTint="#27795A"
        android:thumbTint="#27795A" />

    <!-- ============ 数据 ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="数据"
        android:textColor="#6B8574"
        android:textSize="11sp" />

    <Button
        android:id="@+id/s_refresh"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dialog_field"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="立即刷新（拉服务器最新）"
        android:textColor="#27795A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/s_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8AA294"
        android:textSize="10sp" />
</LinearLayout>
