<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡区的**一行**（ListView 的列表项布局）。

  ⚠️ 2026-11-04 修「同一行重复出现 3 遍」：
  以前用的是 widget_habit_row.xml + 代码 addView 动态塞 chip。但 ListView 复用
  列表项时，同一个 RemoteViews 会被反复 apply —— 而 RemoteViews.addView 是
  **追加**语义、不是覆盖，于是每次重绘都往同一个 LinearLayout 里再 addView 一遍，
  同一行 chip 越叠越多（用户看到「英语 投… 西…」横着重复三组）。

  修法：**预置固定 4 个槽位**（4 是 perRow 的上限，见 CHIP_CELL_DP），重绘时只用
  setTextViewText / setBackgroundResource / setViewVisibility **改**这几个槽，
  再也不用 addView —— 天然幂等，apply 多少次都是同一个结果。

  宽度三档都由 weight 等分，槽位 INVISIBLE（占位）或 GONE（超出 perRow）都成。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/habit_c1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_weight="1"
        android:background="@drawable/widget_habit_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingRight="2dp"
        android:paddingBottom="2dp"
        android:textColor="#1B3A2A"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/habit_c2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_weight="1"
        android:background="@drawable/widget_habit_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingRight="2dp"
        android:paddingBottom="2dp"
        android:textColor="#1B3A2A"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/habit_c3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_weight="1"
        android:background="@drawable/widget_habit_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingRight="2dp"
        android:paddingBottom="2dp"
        android:textColor="#1B3A2A"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/habit_c4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_weight="1"
        android:background="@drawable/widget_habit_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingRight="2dp"
        android:paddingBottom="2dp"
        android:textColor="#1B3A2A"
        android:textSize="8sp" />
</LinearLayout>