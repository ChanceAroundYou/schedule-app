<?xml version="1.0" encoding="utf-8"?>
<!--
  计数器小组件 —— **扁的**（4×1 用）。左右两块，各占一半。

  和 widget_counter_v.xml 是同一套内容换方向：**id 必须一一对应**
  （渲染代码只有一套，按 width/height 比挑布局）。扁的时候横向空间多出来，
  按钮从 40dp 放到 46dp —— 这是这套设计里最想要的手感：按钮大、好点。

  名字的「双 TextView 描边」做法见 widget_counter_v.xml 顶部那段说明。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ctr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ctr_card_bg"
    android:orientation="horizontal"
    android:padding="5dp">

    <!-- ── naonao ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginRight="4dp"
        android:background="@drawable/ctr_zone_pink"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="22dp">

            <TextView
                android:id="@+id/ctr_a_name_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="@color/ctrPinkOutline"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/ctr_a_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="@color/ctrPinkName"
                android:textSize="18sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/ctr_a_minus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ctr_btn_minus_pink"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="−"
                android:textColor="@color/ctrPinkMinusInk"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/ctr_a_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ctrPinkInk"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/ctr_a_plus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ctr_btn_plus_pink"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Kutai ────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/ctr_zone_green"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="22dp">

            <TextView
                android:id="@+id/ctr_b_name_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="@color/ctrGreenOutline"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/ctr_b_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="@color/ctrGreenName"
                android:textSize="18sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/ctr_b_minus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ctr_btn_minus_green"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="−"
                android:textColor="@color/ctrGreenMinusInk"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/ctr_b_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ctrGreenInk"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/ctr_b_plus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ctr_btn_plus_green"
                android:fontFamily="@font/baloo2_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
