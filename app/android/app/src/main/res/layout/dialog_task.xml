<?xml version="1.0" encoding="utf-8"?>
<!--
  任务**编辑 / 删除**弹框。不用打开 App，就在桌面上改。

  2026-10-14（第八轮）：去掉底部按钮行。
  · 结构改成「标题 / 左右分栏」两段 —— 底部「保存 / 删除」整行删除。
  · **保存改为关窗即自动保存**（点弹窗外部 / 返回键时提交，见 TaskDetailActivity）。
  · **删除改由左列的淡色小垃圾桶承担**（点一下弹二次确认）。
  · 左列：上下两个图标 —— 圆形勾选框（mark 完成）+ 小垃圾桶（删除）；
    勾选框圆心与右侧任务文字垂直居中对齐。
  · 第六轮已把左列独立成固定 30dp 宽的一整列、勾选框改圆形（ic_check 重绘成圆）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <!-- 标题：居中 -->
    <TextView
        android:id="@+id/d_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="编辑任务"
        android:textColor="#1B3A2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ===== 左右分栏：左列只放圆形勾选框，右列放全部输入控件 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- 左列：整列留白，**只放勾选框 + 垃圾桶两个图标**（2026-10-14 第八轮）。
             保存/删除的底部按钮行已去掉 —— 保存改为「关窗即存」，删除改由
             这里的淡色垃圾桶承担。 -->
        <LinearLayout
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 圆形勾选框。marginTop=7dp 让**圆心**与右侧任务文字的垂直中心对齐
                 （标题输入框 36dp、文字居中 → 中心在 18dp；圆 22dp → 上移 7dp）。 -->
            <ImageView
                android:id="@+id/d_done"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="7dp"
                android:contentDescription="标记完成"
                android:src="@drawable/ic_check_off" />

            <!-- 淡色小垃圾桶：点一下弹二次确认后删除 -->
            <ImageView
                android:id="@+id/d_trash"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="18dp"
                android:contentDescription="删除任务"
                android:src="@drawable/ic_trash" />
        </LinearLayout>

        <!-- 右列：所有输入控件 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 任务标题输入框 -->
            <EditText
                android:id="@+id/d_title"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/dialog_field"
                android:gravity="center_vertical"
                android:hint="做什么"
                android:inputType="text"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#1B3A2A"
                android:textColorHint="#9BB3A5"
                android:textSize="13sp" />

            <!-- 日期：整行按钮，点了弹日历选择器 -->
            <Button
                android:id="@+id/d_date"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dialog_field"
                android:gravity="center_vertical"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="2026-10-13"
                android:textColor="#1B3A2A"
                android:textSize="12sp" />

            <!-- 起止时间：两个表盘按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/d_start"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/dialog_field"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="不设置"
                    android:textColor="#1B3A2A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:gravity="center"
                    android:text="至"
                    android:textColor="#8AA294"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/d_end"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/dialog_field"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="不设置"
                    android:textColor="#1B3A2A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 时长提示 -->
            <TextView
                android:id="@+id/d_durhint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#8AA294"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>