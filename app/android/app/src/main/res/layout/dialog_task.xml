<?xml version="1.0" encoding="utf-8"?>
<!--
  任务**编辑 / 删除**弹框。不用打开 App，就在桌面上改。

  2026-10-14（第六轮）：左侧留出一整列，只放完成勾选框。
  · 结构改成「标题 / 左右分栏 / 分割线 / 底部按钮」四段：
    中间那段是**左右分栏**——左边一列**固定 30dp 宽、整列留白，只放勾选框**；
    右边一列放标题输入框 + 日期 + 起止时间 + 时长提示。
    这样勾选框和输入区左边缘对齐，勾选框独占一列，右侧全是输入控件。
  · 勾选框由方形改**圆形**（ic_check_on/off 重绘成圆），符合你要的圆形。
  · 底部保存/删除按钮之前**文字被裁掉看不见** —— 原因是按钮写死 32dp 高
    又设了 includeFontPadding=false，字被切了。这轮：按钮高 36dp、
    去掉 includeFontPadding=false、底部再加 4dp 下边距，留足显示空间。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <!-- 标题：居中 -->
    <TextView
        android:id="@+id/d_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="编辑任务"
        android:textColor="#1B3A2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ===== 左右分栏：左列只放圆形勾选框，右列放全部输入控件 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- 左列：整列留白，**只有**勾选框（垂直居中） -->
        <LinearLayout
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 圆形勾选框。ImageView 而非 CheckBox：CheckBox 的 button
                 drawable 会被拉伸填满宽度，长成方形而不是圆形。 -->
            <ImageView
                android:id="@+id/d_done"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="标记完成"
                android:src="@drawable/ic_check_off" />
        </LinearLayout>

        <!-- 右列：所有输入控件 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 任务标题输入框 -->
            <EditText
                android:id="@+id/d_title"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/dialog_field"
                android:gravity="center_vertical"
                android:hint="做什么"
                android:inputType="text"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#1B3A2A"
                android:textColorHint="#9BB3A5"
                android:textSize="13sp" />

            <!-- 日期：整行按钮，点了弹日历选择器 -->
            <Button
                android:id="@+id/d_date"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dialog_field"
                android:gravity="center_vertical"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="2026-10-13"
                android:textColor="#1B3A2A"
                android:textSize="12sp" />

            <!-- 起止时间：两个表盘按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/d_start"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/dialog_field"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="不设置"
                    android:textColor="#1B3A2A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:gravity="center"
                    android:text="至"
                    android:textColor="#8AA294"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/d_end"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/dialog_field"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="不设置"
                    android:textColor="#1B3A2A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 时长提示 -->
            <TextView
                android:id="@+id/d_durhint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#8AA294"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#E4EFE8"
        android:text="" />

    <!-- 底部两个按钮：保存 · 删除，**占满整宽**（左列不参与这一行）。
         高度 36dp、不关includeFontPadding —— 之前写 32dp + 关掉行高，
         结果文字被裁掉看不见。底部留 4dp 余量。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/d_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="保存"
            android:textColor="#27795A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/d_delete"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="删除"
            android:textColor="#C0392B"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>