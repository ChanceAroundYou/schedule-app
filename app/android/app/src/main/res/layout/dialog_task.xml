<?xml version="1.0" encoding="utf-8"?>
<!--
  任务**编辑 / 删除**弹框。

  2026-10-14（第十一轮）：**字段结构与「新建任务」完全对齐** ——
  用户指出：新建弹窗的逻辑没有贯穿到「点开已有任务」这边。
    · 行2 任务名 / 行3 日期 / 行4 开始时间 / 行5 时长 / 行6 重复 / 行7 提醒
    · **时间只设开始** —— 不再有「几号 至 几号」。一整天的时间段改用
      **「时长」** 一行表达（15/30/45/60/90/120/180 分 或 不设置）。
    · 重复 / 提醒 会显示当前值（如「重复：每周三」），点开可改。
  行1 仍是 [完成圆圈] …… [垃圾桶]（两者同尺寸同风格）。
  保存 = 关窗即存；删除 = 右上垃圾桶。

  2026-10-15（第十二轮）：加**最后一行「详细内容」** —— 桌面小组件的任务卡
  第二行就是它（截断版），点开这里看全文 / 改写。放在最后是因为它是唯一
  可能写很长的字段，独占一行且不挤压上面那些固定高度的按钮行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <!-- ===== 行1：完成圆圈 / 垃圾桶（同 22dp、同风格） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/d_done"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="标记完成"
            android:src="@drawable/ic_check_off" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/d_trash"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="删除任务"
            android:src="@drawable/ic_trash" />
    </LinearLayout>

    <!-- ===== 行2：任务名（居中） ===== -->
    <EditText
        android:id="@+id/d_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@null"
        android:gravity="center"
        android:hint="做什么"
        android:inputType="text"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#1B3A2A"
        android:textColorHint="#9BB3A5"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#E4EFE8" />

    <!-- ===== 行3：日期 ===== -->
    <Button
        android:id="@+id/d_date"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="日期：—"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- ===== 行4：开始时间（只有开始） ===== -->
    <Button
        android:id="@+id/d_start"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="开始时间：不设置"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- ===== 行5：时长（替代原来的「至结束」） ===== -->
    <Button
        android:id="@+id/d_duration"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="时长：不设置"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- ===== 行6：重复 ===== -->
    <Button
        android:id="@+id/d_repeat"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="重复：不重复"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- ===== 行7：提醒 ===== -->
    <Button
        android:id="@+id/d_remind"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/dialog_field"
        android:gravity="center_vertical"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="提醒：不提醒"
        android:textColor="#1B3A2A"
        android:textSize="12sp" />

    <!-- ===== 行8：详细内容（多行，自动长高，最多 4 行内部滚动） ===== -->
    <EditText
        android:id="@+id/d_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/dialog_field"
        android:gravity="top"
        android:hint="详细内容"
        android:inputType="textMultiLine"
        android:lines="3"
        android:maxLines="4"
        android:paddingLeft="10dp"
        android:paddingTop="7dp"
        android:paddingRight="10dp"
        android:paddingBottom="7dp"
        android:textColor="#1B3A2A"
        android:textColorHint="#9BB3A5"
        android:textSize="12sp" />
</LinearLayout>
