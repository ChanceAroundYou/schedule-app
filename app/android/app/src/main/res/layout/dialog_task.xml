<?xml version="1.0" encoding="utf-8"?>
<!--
  任务**编辑 / 删除**弹框。

  2026-10-14（第十轮）：
  · **整体缩小**：272 → **240dp**，内边距 16/14 → 14/12，行高 38 → 34dp。
  · **圆圈与垃圾桶统一**：两者都 22dp、同一套描边（见 ic_check_off / ic_trash）。
  · **任务名那行留白收紧**：上边距 12 → 6dp，字号 17 → 16sp。
  · 时间仍是「开始 至 结束」—— 「时间段」就设在这里（新建弹窗只设开始时间）。
  · 保存 = 关窗即存；删除 = 右上垃圾桶（见 TaskDetailActivity）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <!-- ===== 行1：完成圆圈（左）· 垃圾桶（右），同 22dp / 同风格 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/d_done"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="标记完成"
            android:src="@drawable/ic_check_off" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/d_trash"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="删除任务"
            android:src="@drawable/ic_trash" />
    </LinearLayout>

    <!-- ===== 行2：任务名（居中，留白收紧） ===== -->
    <EditText
        android:id="@+id/d_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@null"
        android:gravity="center"
        android:hint="做什么"
        android:inputType="text"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#1B3A2A"
        android:textColorHint="#9BB3A5"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 细分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#E4EFE8" />

    <!-- ===== 行3：日期（居中） ===== -->
    <Button
        android:id="@+id/d_date"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/dialog_field"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="2026-10-13 周二"
        android:textColor="#1B3A2A"
        android:textSize="13sp" />

    <!-- ===== 行4：起止时间（居中）。「时间段」在这里设 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/d_start"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:gravity="center"
            android:text="至"
            android:textColor="#8AA294"
            android:textSize="12sp" />

        <Button
            android:id="@+id/d_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 时长 / 状态提示（居中） -->
    <TextView
        android:id="@+id/d_durhint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#8AA294"
        android:textSize="10sp" />
</LinearLayout>
