<?xml version="1.0" encoding="utf-8"?>
<!--
  任务**编辑 / 删除**弹框。

  2026-10-14（第九轮）按用户思路重排版：
  · **去掉「编辑任务」标题行** —— 一进来就是内容，不要标题。
  · 行1：左＝完成圆圈，右＝垃圾桶（两端对齐）。
  · 行2：任务名（居中、大一号、像标题）。
  · 行3：日期（整行、居中）。
  · 行4：起止时间（居中）。
  · 三行内容一律**水平居中**，配一条细分隔线做层次。
  · 保存 = 关窗即存；删除 = 右上垃圾桶（见 TaskDetailActivity）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp">

    <!-- ===== 行1：完成圆圈（左）· 垃圾桶（右） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/d_done"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="标记完成"
            android:src="@drawable/ic_check_off" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/d_trash"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="删除任务"
            android:src="@drawable/ic_trash" />
    </LinearLayout>

    <!-- ===== 行2：任务名（居中） ===== -->
    <EditText
        android:id="@+id/d_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@null"
        android:gravity="center"
        android:hint="做什么"
        android:inputType="text"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#1B3A2A"
        android:textColorHint="#9BB3A5"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 细分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#E4EFE8" />

    <!-- ===== 行3：日期（居中） ===== -->
    <Button
        android:id="@+id/d_date"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/dialog_field"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="2026-10-13 周二"
        android:textColor="#1B3A2A"
        android:textSize="13sp" />

    <!-- ===== 行4：起止时间（居中） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/d_start"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:gravity="center"
            android:text="至"
            android:textColor="#8AA294"
            android:textSize="12sp" />

        <Button
            android:id="@+id/d_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_field"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="不设置"
            android:textColor="#1B3A2A"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 时长 / 状态提示（居中） -->
    <TextView
        android:id="@+id/d_durhint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#8AA294"
        android:textSize="10sp" />
</LinearLayout>
